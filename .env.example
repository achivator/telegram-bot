# Copy to .env and fill in. Never commit real values.

MONGODB_URI=mongodb://localhost:27017
ACHIVATOR_TOKEN=123456:replace_with_bot_token

# Points per positive reaction are multiplied by this for the chat creator's
# own messages (funds the pool faster). Default: 10.
CREATOR_MULTIPLIER=10

# Anti-farming for reaction points (fake accounts are cheap):
# a reactor needs this many messages in the chat before their reactions pay,
MIN_REACTOR_MESSAGES=5
# one reactor pays one receiver at most this many reactions per UTC day,
PAIR_DAILY_CAP=5
# and a receiver earns at most this many reaction points per day per chat.
RECEIVER_DAILY_CAP=200

# Upper bound for a single manual /reward grant by an admin or an admin bot.
# Default: 1000.
REWARD_MAX_POINTS=1000

# How often the bot sends the point price announcements queued by the mini app
# and applies scheduled price decreases that are due, in ms. Default: 60000.
ANNOUNCE_INTERVAL_MS=60000

# When a price decrease is announced, members with unclaimed points in the chat
# also get a private message (only those who have started the bot receive it).
# Private messages go out at most this many per second: Telegram allows about
# 30 per second to different users, above that it answers 429. Default: 20,
# capped at 25.
DM_RATE_PER_SEC=20
# How often the private message queue is checked, in ms; each check sends at
# most DM_RATE_PER_SEC × DM_INTERVAL_MS / 1000 messages. Default: 1000.
DM_INTERVAL_MS=1000

# In production the bot runs on a webhook; in development it long-polls.
NODE_ENV=development
# Set true only for a bot created in Telegram's test environment.
TELEGRAM_TEST_ENV=false
WEBHOOK_URL=
PORT=3000

# Grafana logging: optional in development, required when NODE_ENV=production.
ACHIVATOR_GRAFANA_USER_ID=
ACHIVATOR_GRAFANA_TOKEN=
